{
  "name": "minsa-incidencias-backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "docker:up": "docker compose up -d --build --wait --wait-timeout 180",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down",
    "crear-admin": "node --env-file=.env dist/scripts/crear-admin.js"
  },
  "type": "module",
  "dependencies": {
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  }
}
